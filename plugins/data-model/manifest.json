{
  "id": "data-model",
  "name": "Data Model",
  "version": "1.0.0",
  "engine": ">=0.2.0",
  "description": "数据模型可视化编辑与智能体对话，支持表/字段/关系编辑、DBML 导入导出、AI 建模",
  "author": "WorkAvatar",
  "main": "dist/main/index.cjs",
  "renderer": "dist/renderer/index.js",
  "locale": "locale",
  "ipc": [
    "project-list", "project-create", "project-open", "project-delete", "project-save", "project-rename",
    "project-export-file", "project-import-file",
    "model-get", "model-sync",
    "dbml-import", "dbml-export",
    "employees-list", "providers-list",
    "settings-get", "settings-set", "data-dir", "data-dir-open",
    "chat-send", "chat-cancel", "chat-history", "chats-list", "chat-delete", "chat-delete-message",
    "chat-delete-task-dir", "chat-open-dir"
  ],
  "capabilities": [
    { "domain": "data", "entities": ["conversations", "employees", "llmProviders", "messages"], "access": "write" },
    { "domain": "execute", "kinds": ["agent-chat"] },
    { "domain": "events", "subscribe": ["employee:created", "employee:updated", "employee:deleted", "model:renamed", "provider:changed"] }
  ],
  "nav": {
    "label": "navLabel",
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/><path d=\"M2.5 3.5v9c0 1.1 2.46 2 5.5 2s5.5-.9 5.5-2v-9\"/><path d=\"M2.5 8c0 1.1 2.46 2 5.5 2s5.5-.9 5.5-2\"/></svg>",
    "order": 40,
    "detachable": true
  }
}
