{
  "name": "workavatar",
  "version": "1.7.0",
  "description": "本地优先的办公数字员工",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "gen:buildinfo": "node scripts/generate-build-info.mjs",
    "gen:launcher": "node scripts/build-launcher.mjs",
    "gen:sandbox": "node scripts/build-sandbox.mjs",
    "gen:viewer-assets": "file-viewer-copy-assets --renderers pdf,office-word-openxml,spreadsheet-openxml,office-presentation",
    "predev": "npm run gen:buildinfo && npm run gen:sandbox && npm run gen:viewer-assets && node scripts/build-plugins.mjs",
    "prebuild": "npm run gen:buildinfo && npm run gen:sandbox && npm run gen:viewer-assets && node scripts/build-plugins.mjs && node scripts/build-launcher.mjs",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:release": "npm run build -- --config.compression=maximum",
    "build:win": "node scripts/build-launcher.mjs && node scripts/build-sandbox.mjs && electron-builder --win",
    "build:mac": "electron-builder --mac --config.disableAsarIntegrity=true",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:plugins": "vitest run --config plugins/vitest.config.ts",
    "test:all": "npm run test && npm run test:plugins",
    "test:watch": "vitest --config tests/vitest.config.ts"
  },
  "keywords": [
    "数字员工",
    "AI",
    "本地优先",
    "零代码"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@node-rs/jieba": "^2.0.4",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.12.0",
    "file2md": "^2.0.1",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "^1.30.0",
    "paddleocr": "^1.2.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "sherpa-onnx-node": "^1.13.8",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.9.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/icons-svg": "^4.6.0",
    "@dbml/core": "^10.3.1",
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@file-viewer/react-full": "^3.2.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "filesize": "^11.0.26",
    "i18next": "^26.5.2",
    "immer": "^11.1.21",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@^6.0.3",
    "vditor": "^4.0.1",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  }
}
