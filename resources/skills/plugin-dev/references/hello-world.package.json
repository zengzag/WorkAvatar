{
  "name": "workavatar-plugin-hello-world",
  "version": "1.2.0",
  "private": true,
  "description": "WorkAvatar 最小示例插件（兼作第三方开发模板，可独立构建打包）。依赖声明约定：dependencies=打包进 dist 的运行时依赖；nativeDependencies=宿主借用原生模块（不打包，仅限 plugin-sdk/host-native-dependencies.json 白名单，构建脚本会校验）；devDependencies=共享库（__WA_HOST__ 注入）+ 构建工具",
  "type": "module",
  "scripts": {
    "build": "node build-plugin.mjs",
    "build:zip": "node build-plugin.mjs --zip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "nativeDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.5.17",
    "antd": "^6.3.7",
    "esbuild": "^0.28.0",
    "i18next": "^26.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.7",
    "typescript": "^6.0.3"
  }
}
